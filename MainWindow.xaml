<Window x:Class="Blueberry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blueberry"
        Height="640" Width="780"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="SF Pro Display, Segoe UI Variable Display, Segoe UI"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Estilo Mac Button Pill -->
        <Style x:Key="MacPillButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Container Principal estilo Janela macOS -->
    <Border CornerRadius="16" Background="#FBFBFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- macOS Titlebar -->
                <RowDefinition Height="52"/>
                <!-- Hero Drop Zone -->
                <RowDefinition Height="220"/>
                <!-- Atalhos / Dicas Mac Pills -->
                <RowDefinition Height="Auto"/>
                <!-- Histórico de Conversões -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TÍTULO MAC (com botões Semáforo) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Traffic Lights (Fechar, Minimizar, Maximizar) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <!-- Fechar (Vermelho) -->
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FF5F56" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonUp="BtnClose_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#D0352B" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <!-- Minimizar (Amarelo) -->
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonUp="BtnMinimize_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#D29918" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <!-- Expandir (Verde) -->
                    <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F" Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#1E9C30" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                </StackPanel>

                <!-- Título Centralizado -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="apple_blueberry_raw.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Blueberry" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="Ajustes" Style="{StaticResource MacSecondaryButton}" Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>

            <!-- ÁREA HERO DE DROP ESTILO TANGERINE -->
            <Border Grid.Row="1" x:Name="DropZoneBorder"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Margin="24,0,24,12"
                    Cursor="Hand"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    MouseLeftButtonUp="DropZone_MouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <!-- Borda tracejada interna sutil -->
                    <Rectangle Stroke="#94A3B8" StrokeThickness="1.2" StrokeDashArray="4 4" RadiusX="14" RadiusY="14" Margin="8"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Emoji Oficial do iPhone sem fundo -->
                        <Image Source="apple_blueberry_raw.png" Width="72" Height="72" Margin="0,0,0,10"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock x:Name="TxtDropTitle" Text="Arraste qualquer arquivo aqui"
                                   FontWeight="Bold" FontSize="16" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ou selecione do seu computador para abrir a roda radial"
                                   FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,12"/>

                        <Button Content="Escolher Arquivo..." Style="{StaticResource MacPillButton}"
                                HorizontalAlignment="Center" Click="BtnSelectFile_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ATALHOS / DICAS ESTILO MAC -->
            <Grid Grid.Row="2" Margin="24,0,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dica 1: Shift para converter -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="12" Padding="12,10" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="⇧ Shift" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Converter formatos" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                            <TextBlock Text="Ao arrastar no Windows" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dica 2: Ctrl+Shift para ferramentas -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="12" Padding="12,10" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F3E8FF" BorderBrush="#D8B4FE" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="⌃ Ctrl + ⇧ Shift" FontWeight="Bold" FontSize="11" Foreground="#6B21A8"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ferramentas de edição" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                            <TextBlock Text="Comprimir, P&amp;B, Mudo, etc" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HISTÓRICO MAC CARD -->
            <Grid Grid.Row="3" Margin="24,0,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Histórico Recente" FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                    <Button Content="Limpar" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Cursor="Hand" FontSize="11" Click="BtnClearHistory_Click"/>
                </Grid>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" BorderBrush="#F1F5F9" BorderThickness="1"
                                        CornerRadius="8" Padding="12,8" Margin="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Source="apple_blueberry_raw.png" Width="18" Height="18"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding OriginalSizeFormatted}" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock Text=" -> " FontSize="10" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding ConvertedSizeFormatted}" FontSize="10" Foreground="#15803D" FontWeight="Bold"/>
                                                <TextBlock Text="  •  " FontSize="10" Foreground="#CBD5E1"/>
                                                <TextBlock Text="{Binding TargetFormat}" FontSize="10" Foreground="#2563EB" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#166534"/>
                                        </Border>

                                        <Button Grid.Column="3" Content="Abrir Pasta" Style="{StaticResource MacSecondaryButton}"
                                                Tag="{Binding TargetPath}" Click="BtnOpenFolder_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
