<Window x:Class="Blueberry.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blueberry"
        Height="500" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="RootGrid" Width="500" Height="500" Background="Transparent" AllowDrop="True">

        <!-- Canvas onde as pétalas são desenhadas (IsHitTestVisible=False para não bugar o drag-and-drop) -->
        <Canvas x:Name="PetalCanvas" Width="500" Height="500"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False"/>

        <!-- Círculo Central macOS: Área Neutra de Cancelamento -->
        <Border x:Name="CenterCircle"
                Width="134" Height="134"
                CornerRadius="67"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderThickness="1.5" BorderBrush="#E2E8F0"
                IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F1F5F9" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270"
                                  Color="#000000" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <!-- Emoji oficial transparente da Apple -->
                <Image x:Name="ImgCenterIcon" Source="apple_blueberry_raw.png"
                       Width="52" Height="52"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock x:Name="TxtFileIcon" Text=""
                           FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,0,0,16" Visibility="Collapsed"/>

                <!-- Indicador de Status / Cancelar ou Tamanho -->
                <Border x:Name="CenterPill" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,12" Background="#1E293B" CornerRadius="10" Padding="8,3">
                    <TextBlock x:Name="TxtFileSize" Text="–"
                               FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                               FontFamily="SF Pro Display, Segoe UI Variable, Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <!-- Overlay de Sucesso ou Progresso -->
        <Border x:Name="StatusOverlay"
                Width="134" Height="134" CornerRadius="67"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#1D4ED8" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                  Color="#2563EB" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtStatusText" Text="Concluído"
                           FontSize="15" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center"
                           FontFamily="SF Pro Display, Segoe UI Variable, Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Badge de Modo: CONVERTER ou FERRAMENTAS -->
        <Border x:Name="ModeBadge"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="0,118,0,0"
                Background="#CC2563EB" CornerRadius="10" Padding="10,4"
                IsHitTestVisible="False">
            <TextBlock x:Name="TxtModeBadge" Text="CONVERTER"
                       FontSize="9" FontWeight="Bold" Foreground="White"
                       FontFamily="SF Pro Display, Segoe UI Variable, Segoe UI"/>
        </Border>

    </Grid>
</Window>
