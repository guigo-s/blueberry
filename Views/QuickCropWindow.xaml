<Window x:Class="Blueberry.Views.QuickCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cortar Imagem / Vídeo - Blueberry"
        Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="SF Pro Display, Segoe UI Variable Display, Segoe UI">

    <!-- Container estilo macOS Frosted Glass -->
    <Border CornerRadius="18" Background="#FAFAFD" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Topbar Mac com semáforo -->
                <RowDefinition Height="Auto"/>
                <!-- Seletor de Proporções (Pills Apple) -->
                <RowDefinition Height="Auto"/>
                <!-- Área de Prévia do Corte -->
                <RowDefinition Height="*"/>
                <!-- Rodapé com Informações e Botão Salvar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR MAC -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Semáforo Vermelho -->
                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" Background="#FF5F56"
                        Cursor="Hand" MouseLeftButtonUp="BtnCancel_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#D0352B" Opacity="0.3"/>
                    </Border.Effect>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✂️  Cortar Enquadramento (Crop)" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                </StackPanel>
            </Grid>

            <!-- SELETOR DE PROPORÇÕES (Pills estilo iPhone) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <RadioButton x:Name="Rb1x1" Content="1:1 (Quadrado)" GroupName="AspectRatio"
                             IsChecked="True" Checked="Aspect_Checked" Margin="0,0,8,0"
                             Style="{DynamicResource AspectRadioStyle}"/>
                <RadioButton x:Name="Rb9x16" Content="9:16 (Reels/TikTok)" GroupName="AspectRatio"
                             Checked="Aspect_Checked" Margin="0,0,8,0"
                             Style="{DynamicResource AspectRadioStyle}"/>
                <RadioButton x:Name="Rb16x9" Content="16:9 (Paisagem)" GroupName="AspectRatio"
                             Checked="Aspect_Checked" Margin="0,0,8,0"
                             Style="{DynamicResource AspectRadioStyle}"/>
                <RadioButton x:Name="Rb4x3" Content="4:3 (Clássico)" GroupName="AspectRatio"
                             Checked="Aspect_Checked"
                             Style="{DynamicResource AspectRadioStyle}"/>
            </StackPanel>

            <!-- ÁREA DE PREVIEW COM OVERLAY DE CORTE -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,14">
                <Grid x:Name="PreviewContainer" SizeChanged="PreviewContainer_SizeChanged">
                    <!-- Imagem ou Capa do Vídeo -->
                    <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Máscara escura ao redor do corte -->
                    <Canvas x:Name="CropCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Caixa delimitadora do corte (branca com sombra) -->
                    <Border x:Name="CropBox" BorderBrush="#38BDF8" BorderThickness="2" Background="#1538BDF8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#38BDF8" Opacity="0.8"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Guias da regra dos terços -->
                            <Rectangle Stroke="#6038BDF8" StrokeDashArray="2 2" Margin="0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="TxtBoxRatio" Text="1:1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Background="#80000000" Padding="6,2"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RODAPÉ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" Text="arquivo.png" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"
                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                    <TextBlock x:Name="TxtDimensions" Text="Proporção selecionada: 1:1" FontSize="11" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Background="#F1F5F9" Foreground="#475569" FontWeight="Medium"
                            FontSize="12" Padding="16,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="✂️ Salvar Corte ao Lado do Original" Background="#2563EB" Foreground="#FFFFFF"
                            FontWeight="Bold" FontSize="12" Padding="20,8" BorderThickness="0" Cursor="Hand"
                            Click="BtnSaveCrop_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <!-- Estilo de Pill RadioButton do iPhone -->
        <Style x:Key="AspectRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="14" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
