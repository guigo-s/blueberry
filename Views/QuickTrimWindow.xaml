<Window x:Class="Blueberry.Views.QuickTrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cortar Mídia - Blueberry"
        Height="460" Width="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="SF Pro Display, Segoe UI Variable Display, Segoe UI">

    <!-- Container macOS Estilo Modal -->
    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior Mac -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botão Fechar Vermelho -->
                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" Background="#FF5F56"
                        Cursor="Hand" MouseLeftButtonUp="BtnCancel_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#D0352B" Opacity="0.3"/>
                    </Border.Effect>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✂️  Cortar Duração (Trim)" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                </StackPanel>
            </Grid>

            <!-- Área de Preview de Vídeo / Áudio -->
            <Border Grid.Row="1" Background="#090E1A" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,14">
                <Grid>
                    <MediaElement x:Name="MediaPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True" MediaOpened="MediaPreview_MediaOpened"/>
                    <Button x:Name="BtnPlayPause" Content="▶ Reproduzir" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#90000000" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                            Padding="14,6" BorderThickness="0" Cursor="Hand" Click="BtnPlayPause_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Sliders de Início e Fim -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Ponto Inicial (Início):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                    <TextBlock x:Name="TxtStartVal" Text="00:00" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                </Grid>
                <Slider x:Name="SliderStart" Minimum="0" Value="0" SmallChange="1" LargeChange="5"
                        ValueChanged="SliderStart_ValueChanged"/>

                <Grid Margin="0,8,0,4">
                    <TextBlock Text="Ponto Final (Fim):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                    <TextBlock x:Name="TxtEndVal" Text="00:00" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                </Grid>
                <Slider x:Name="SliderEnd" Minimum="0" Value="0" SmallChange="1" LargeChange="5"
                        ValueChanged="SliderEnd_ValueChanged"/>
            </StackPanel>

            <!-- Informações de Duração do Trecho Cortado -->
            <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <Grid>
                    <TextBlock x:Name="TxtFileName" Text="arquivo.mp4" FontSize="11" Foreground="#334155"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <TextBlock x:Name="TxtCutSummary" Text="Duração final: 00:00" HorizontalAlignment="Right"
                               FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Botões de Ação -->
            <Grid Grid.Row="4">
                <Button Content="Cancelar" Background="#F1F5F9" Foreground="#475569" FontWeight="Medium"
                        FontSize="12" Padding="16,8" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Left" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="✂️ Salvar Corte ao Lado do Original" Background="#2563EB" Foreground="#FFFFFF"
                        FontWeight="Bold" FontSize="12" Padding="20,8" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Right" Click="BtnSaveTrim_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
